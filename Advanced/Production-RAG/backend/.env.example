# Copy to .env (backend/.env). Never commit real values.

# LLM used for query rewriting, grounded generation, and answer validation
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embeddings (local sentence-transformers model, downloaded on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Reranking
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=180

# Retrieval
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4

# Storage
INDEX_DIR=./data/index
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25

# API
API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO
