# Copy to .env at this directory's root (used by docker-compose).
# Backend and frontend each also have their own .env.example for
# standalone (non-Docker) runs.

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true

CHUNK_SIZE=1000
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4

MAX_FILE_SIZE_MB=25
LOG_LEVEL=INFO

# Used by the frontend container to reach the backend container
BACKEND_URL=http://backend:8000
