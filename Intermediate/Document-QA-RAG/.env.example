# Copy this file to .env and fill in real values. Never commit .env.

# LLM used only for grounded answer GENERATION (not for embeddings).
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Local embedding model (downloaded from HuggingFace on first run, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150
